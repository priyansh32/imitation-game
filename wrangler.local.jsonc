{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imitation-game-local",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "DEVELOPMENT": "true",
    "DEV_TOKEN": "local-inspection-only",
    "ADMIN_TOKEN": "",
    "LOCAL_ADMIN": "false"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/agents/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "GameRoom",
        "name": "ROOMS"
      },
      {
        "class_name": "PersistentPlayer",
        "name": "PLAYERS"
      },
      {
        "name": "MATCHMAKER",
        "class_name": "Matchmaker"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GameRoom",
        "PersistentPlayer"
      ]
    },
    {
      "tag": "v3-matchmaker",
      "new_sqlite_classes": [
        "Matchmaker"
      ]
    }
  ],
  "observability": {
    "enabled": true
  }
}
