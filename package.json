{
  "name": "human-imitation-game",
  "version": "1.0.0",
  "private": true,
  "description": "A social deduction game against persistent artificial players",
  "keywords": [
    "agents",
    "ai",
    "cloudflare"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:local": "node scripts/dev.mjs",
    "dev:multiplayer": "node tests/multiplayer.mjs",
    "test:multiplayer": "node tests/multiplayer.mjs",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "types": "wrangler types env.d.ts",
    "check": "tsc --noEmit && oxlint src/",
    "test": "node --import tsx --test tests/game.test.ts tests/decision.test.ts",
    "test:integration": "node tests/integration.mjs",
    "format": "oxfmt --write src tests scripts vite.config.ts",
    "test:multiplayer:ui": "node tests/multiplayer-ui.mjs"
  },
  "dependencies": {
    "agents": "^0.17.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@cloudflare/vite-plugin": "^1.46.0",
    "@playwright/test": "^1.63.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "wrangler": "^4.136.1",
    "ws": "^8.21.3"
  },
  "allowScripts": {
    "core-js-pure@3.49.0": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260721.1": true,
    "sharp@0.34.5": true,
    "fsevents@2.3.3": true
  }
}
